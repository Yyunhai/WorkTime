<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 的系统 SplashScreen 属性只在 API 31+ 生效。 -->
    <style name="Theme.WorkTime" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowSplashScreenBackground">@color/app_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_art</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
    </style>
</resources>
